{
  "name": "storybroker-mcp",
  "version": "0.1.0",
  "description": "Map the rights in a film or story project folder and get it ready to release, re-release or sell. An MCP server.",
  "license": "Apache-2.0",
  "homepage": "https://www.story.broker",
  "repository": { "type": "git", "url": "git+https://github.com/ckaico/storybroker-mcp.git" },
  "bugs": { "url": "https://github.com/ckaico/storybroker-mcp/issues" },
  "type": "module",
  "bin": {
    "storybroker-mcp": "dist/index.js"
  },
  "files": ["dist", "skill", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --outfile dist/index.js --packages=external",
    "test": "bun test/smoke.ts",
    "prepublishOnly": "bun run build && bun test/smoke.ts"
  },
  "keywords": ["mcp", "film", "rights", "chain of title", "entertainment", "licensing"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mammoth": "^1.13.0",
    "unpdf": "^2.1.0",
    "zod": "4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
